<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer glow -->
    <item android:left="-1dp" android:top="-1dp" android:right="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1100E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#5500E5FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- inner fill -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="180"
                android:startColor="#FF0D1424" android:endColor="#FF0A101E" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>