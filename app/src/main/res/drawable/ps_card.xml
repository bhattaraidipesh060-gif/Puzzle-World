<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card surface + press ripple (16dp radius) -->
    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="@color/ps_surface" />
                    <stroke android:width="1dp" android:color="@color/ps_stroke" />
                </shape>
            </item>
        </ripple>
    </item>
    <!-- 1dp semi-transparent gradient highlight on the top edge (glass sheen) -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:height="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="0"
                android:startColor="#33FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#05FFFFFF" />
        </shape>
    </item>
</layer-list>
