<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_rooms_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ps_card_glow"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏠 Escape Rooms"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/sora_bold"
        android:textColor="@color/ps_text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap a room to jump straight in"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/ps_muted"
        android:layout_marginTop="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/room_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/room_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter"
        android:textColor="@color/ps_text"
        android:gravity="center"
        android:background="@drawable/ps_btn_ghost"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_marginTop="14dp" />
</LinearLayout>
