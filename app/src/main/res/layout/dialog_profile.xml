<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ps_card_glow"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/profile_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="P"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/sora_bold"
            android:textColor="@color/ps_on_accent"
            android:background="@drawable/avatar_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/sora_bold"
                android:textColor="@color/ps_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Signed in"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/ps_muted" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="#1AFFFFFF" />

    <!-- My Stats -->
    <LinearLayout
        android:id="@+id/profile_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="17sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="My Stats"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_dim" />
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:id="@+id/profile_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️"
            android:textSize="17sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Settings"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_dim" />
    </LinearLayout>

    <!-- Sign out -->
    <LinearLayout
        android:id="@+id/profile_signout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚪"
            android:textSize="17sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Sign out"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_rose" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_dim" />
    </LinearLayout>

    <!-- Terms & Privacy -->
    <LinearLayout
        android:id="@+id/profile_terms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📄"
            android:textSize="17sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Terms &amp; Privacy"
            android:textSize="15sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/ps_dim" />
    </LinearLayout>
</LinearLayout>
