<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ps_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/ps_card"
            android:layout_margin="12dp"
            android:padding="14dp">

            <TextView android:id="@+id/sudoku_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧩 Sudoku — Medium"
                android:textColor="@color/ps_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView android:id="@+id/sudoku_status"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ps_muted"
                    android:textSize="13sp"
                    android:gravity="start"
                    android:text="Tap a cell, then enter a number" />

                <TextView android:id="@+id/sudoku_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ 0:00"
                    android:textColor="@color/ps_amber"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Board -->
        <com.jeiu.puzzleworld.SudokuView android:id="@+id/sudoku_board"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/ps_card" />

        <!-- Number pad row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp">

            <Button android:id="@+id/sudoku_pad_1"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="1" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_2"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="2" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_3"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="3" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_4"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="4" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_5"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="5" android:textSize="16sp" android:textColor="@color/ps_text"
                android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Number pad row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp">

            <Button android:id="@+id/sudoku_pad_6"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="6" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_7"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="7" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_8"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="8" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />
            <Button android:id="@+id/sudoku_pad_9"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="9" android:textSize="16sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/ps_surface2"
                android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sudoku_pad_clear"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:text="⌫" android:textSize="16sp" android:textColor="@color/ps_on_accent"
                android:background="@drawable/ps_chip_active"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Actions row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sudoku_btn_undo"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:text="🔄  UNDO" android:textSize="13sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="4dp" android:background="@drawable/ps_btn_ghost"
                android:fontFamily="sans-serif-medium" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sudoku_btn_hint"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:text="💡  HINT" android:textSize="13sp" android:textColor="@color/ps_on_accent"
                android:layout_marginEnd="4dp" android:background="@drawable/ps_btn_gold"
                android:fontFamily="sans-serif-medium" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sudoku_btn_notes"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:text="✎  NOTES" android:textSize="13sp" android:textColor="@color/ps_text"
                android:background="@drawable/ps_btn_purple"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Actions row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sudoku_btn_new"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:text="🎯  NEW GAME" android:textSize="13sp" android:textColor="@color/ps_text"
                android:layout_marginEnd="6dp" android:background="@drawable/ps_btn_ghost"
                android:fontFamily="sans-serif-medium" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/sudoku_btn_check"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                android:text="✓  CHECK" android:textSize="13sp" android:textColor="@color/ps_on_accent"
                android:layout_marginStart="6dp" android:background="@drawable/ps_btn_emerald"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <com.jeiu.puzzleworld.CelebrationView android:id="@+id/sudoku_celebration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
