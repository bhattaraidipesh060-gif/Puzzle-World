<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ps_bg"
    android:fitsSystemWindows="true">

    <!-- Header card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ps_card"
        android:layout_margin="12dp"
        android:padding="16dp">

        <TextView android:id="@+id/dc_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗓️ Daily Challenge"
            android:textColor="@color/ps_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView android:id="@+id/dc_challenge_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ps_muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Loading…" />
    </LinearLayout>

    <!-- Puzzle prompt + hints -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/dc_puzzle_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/ps_card"
                android:padding="16dp"
                android:textSize="17sp"
                android:textColor="@color/ps_cyan"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textIsSelectable="false"
                android:letterSpacing="0.03"
                android:lineSpacingExtra="4dp" />

            <TextView android:id="@+id/dc_hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/ps_card"
                android:padding="14dp"
                android:textSize="14sp"
                android:textColor="@color/ps_amber"
                android:textIsSelectable="false"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Answer card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ps_card"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp">

        <EditText android:id="@+id/dc_answer_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="🔑 Enter your answer…"
            android:textColor="@color/ps_text"
            android:textColorHint="@color/ps_dim"
            android:background="@drawable/ps_search"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:inputType="text"
            android:imeOptions="actionDone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/dc_btn_check"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="✓  CHECK"
                android:textSize="13sp"
                android:textColor="@color/ps_on_accent"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ps_btn_primary"
                android:fontFamily="sans-serif-medium" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/dc_btn_hint"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="💡  HINT"
                android:textSize="13sp"
                android:textColor="@color/ps_on_accent"
                android:layout_marginStart="6dp"
                android:background="@drawable/ps_btn_gold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status line -->
    <TextView android:id="@+id/dc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ps_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:text="Loading…" />
</LinearLayout>
