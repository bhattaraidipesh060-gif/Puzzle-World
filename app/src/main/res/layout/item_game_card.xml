<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/ps_card"
    android:stateListAnimator="@animator/card_press"
    android:clickable="true"
    android:focusable="true">

    <TextView android:id="@+id/game_art"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center"
        android:text="🚪"
        android:textSize="40sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView android:id="@+id/game_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ps_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView android:id="@+id/game_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ps_muted"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView android:id="@+id/game_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ps_emerald"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:background="@drawable/ps_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="10dp" />

        <TextView android:id="@+id/game_enter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="▶  Enter"
            android:textColor="@color/ps_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/ps_btn_primary"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>
