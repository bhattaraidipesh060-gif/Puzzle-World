<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PuzzleWorld"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuzzleWorld">

        <!-- Login is the entry point; Home is the game-select hub. -->
        <activity android:name=".LoginActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".HomeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".SudokuActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".WordDescramblerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".DailyChallengeActivity"
            android:exported="false" />

        <activity android:name=".LeaderboardActivity"
            android:exported="false" />
        <activity android:name=".TermsActivity"
            android:exported="false" />
        <activity android:name=".AchievementsActivity"
            android:exported="false" />
    </application>
</manifest>
