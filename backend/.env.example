# PuzzleWorld backend configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Secret used to sign JWT auth tokens (HS256). Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PW_JWT_SECRET=

# Demo account (optional). If both are set, an idempotent demo login is created
# on startup. Leave empty to disable. NEVER commit the real password here.
PW_DEMO_USERNAME=
PW_DEMO_PASSWORD=

# Comma-separated list of allowed CORS origins (optional; sensible default is used).
#CORS_ORIGINS=

# Path to the SQLite database file (default: ./puzzleworld.db)
#PW_DB_PATH=

# Path to the Android app's room JSON assets (default: ../app/src/main/assets/rooms)
#ROOMS_ASSETS_DIR=

# HTTP port (default: 3000)
#PORT=3000
