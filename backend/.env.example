# PuzzleWorld backend configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Secret used to sign JWT auth tokens (HS256). Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PW_JWT_SECRET=

# ── Email / OTP delivery (SMTP) ──────────────────────────────────────────────
# Set PW_EMAIL_USER + PW_EMAIL_PASS to send real verification-code emails.
# Without them the backend falls back to logging the code to the server console.
# For Gmail: PW_EMAIL_PASS is a 16-character App Password (NOT the account
# password) — enable 2-Step Verification, then create an App Password.
PW_EMAIL_USER=
PW_EMAIL_PASS=

# Provider preset (gmail | naver | daum | yahoo | outlook). Default: gmail.
#PW_SMTP_PROVIDER=gmail

# Override host/port/secure if using a custom relay (defaults come from the
# preset above: gmail/naver/daum = smtp.<host> :465 SSL; outlook :587 STARTTLS).
#PW_SMTP_HOST=
#PW_SMTP_PORT=
#PW_SMTP_SECURE=true

# "From" address shown on outgoing mail (default: PW_EMAIL_USER).
#PW_EMAIL_FROM=

# Demo account (optional). If both are set, an idempotent demo login is created
# on startup. Leave empty to disable. NEVER commit the real password here.
PW_DEMO_USERNAME=
PW_DEMO_PASSWORD=

# Comma-separated list of allowed CORS origins (optional; sensible default is used).
#CORS_ORIGINS=

# Path to the SQLite database file (default: ./puzzleworld.db)
#PW_DB_PATH=

# Path to the Android app's room JSON assets (default: ../app/src/main/assets/rooms)
#ROOMS_ASSETS_DIR=

# HTTP port (default: 3000)
#PORT=3000
